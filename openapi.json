{
  "info": {
    "title": "Exercise Library API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "servers": [
    {
      "url": "https://exercises.fitmeproject.com"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "description": "A Clerk session token, or the Coach's or MCP server's secret",
        "scheme": "bearer",
        "type": "http"
      }
    },
    "schemas": {
      "ExercisePage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExerciseSummary"
            }
          },
          "hasMore": {
            "type": "boolean",
            "description": "Whether more matches follow this page."
          },
          "total": {
            "type": "integer",
            "description": "How many Exercises match, across every page."
          }
        },
        "required": [
          "data",
          "hasMore",
          "total"
        ]
      },
      "ExerciseSummary": {
        "type": "object",
        "properties": {
          "muscle_groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MuscleGroup"
            }
          },
          "name": {
            "type": "string",
            "example": "Bench Press"
          },
          "slug": {
            "type": "string",
            "example": "bench-press"
          },
          "thumbnail_url": {
            "type": "string",
            "format": "uri",
            "description": "The thumbnail through Supabase's image transformation endpoint: append `width` and/or `height` query parameters."
          },
          "video_url": {
            "type": "string",
            "format": "uri",
            "description": "The public video URL (mp4)."
          }
        },
        "required": [
          "muscle_groups",
          "name",
          "slug",
          "thumbnail_url",
          "video_url"
        ]
      },
      "MuscleGroup": {
        "type": "string",
        "enum": [
          "chest",
          "back",
          "shoulders",
          "biceps",
          "triceps",
          "forearms",
          "abs",
          "obliques",
          "quadriceps",
          "hamstrings",
          "glutes",
          "calves",
          "traps",
          "lats",
          "lower-back",
          "cardio",
          "full-body"
        ]
      },
      "ExerciseBatch": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExerciseSummary"
            },
            "description": "The Exercises found, in the order their slugs were asked."
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The asked Exercise slugs no Exercise has, in asked order.",
            "example": [
              "no-such-exercise"
            ]
          }
        },
        "required": [
          "data",
          "missing"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Exercise": {
        "type": "object",
        "properties": {
          "muscle_groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MuscleGroup"
            }
          },
          "name": {
            "type": "string",
            "example": "Bench Press"
          },
          "slug": {
            "type": "string",
            "example": "bench-press"
          },
          "thumbnail_url": {
            "type": "string",
            "format": "uri",
            "description": "The thumbnail through Supabase's image transformation endpoint: append `width` and/or `height` query parameters."
          },
          "video_url": {
            "type": "string",
            "format": "uri",
            "description": "The public video URL (mp4)."
          },
          "description": {
            "type": "string",
            "description": "Markdown."
          },
          "instructions": {
            "type": "string",
            "description": "Markdown."
          }
        },
        "required": [
          "muscle_groups",
          "name",
          "slug",
          "thumbnail_url",
          "video_url",
          "description",
          "instructions"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "The API is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/exercises": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List Exercises, or look up a batch by Exercise slug",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Page size.",
              "example": 20
            },
            "required": false,
            "description": "Page size.",
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "$ref": "#/components/schemas/MuscleGroup"
            },
            "required": false,
            "description": "Only Exercises with this muscle group.",
            "name": "muscle_group",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "default": 0,
              "description": "How many matches to skip.",
              "example": 0,
              "minimum": 0
            },
            "required": false,
            "description": "How many matches to skip.",
            "name": "offset",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 100,
              "description": "Case-insensitive substring of the name, surrounding whitespace ignored; `%` and `_` match only themselves.",
              "example": "bench"
            },
            "required": false,
            "description": "Case-insensitive substring of the name, surrounding whitespace ignored; `%` and `_` match only themselves.",
            "name": "search",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Comma-separated Exercise slugs to look up instead of listing: at most 40 (a repeated one is answered once), not combined with `search`, `muscle_group`, `limit` or `offset`.",
              "example": "bench-press,squat"
            },
            "required": false,
            "description": "Comma-separated Exercise slugs to look up instead of listing: at most 40 (a repeated one is answered once), not combined with `search`, `muscle_group`, `limit` or `offset`.",
            "name": "slugs",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of matching Exercises, alphabetical by name (`ExercisePage`), or with `slugs`, the Exercises found (`ExerciseBatch`)",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ExercisePage"
                    },
                    {
                      "$ref": "#/components/schemas/ExerciseBatch"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "An invalid query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid Clerk session token or server secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/exercises/{slug}": {
      "get": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Get one Exercise by Exercise slug",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "bench-press"
            },
            "required": true,
            "name": "slug",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The Exercise",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exercise"
                }
              }
            }
          },
          "401": {
            "description": "No valid Clerk session token or server secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No Exercise has this Exercise slug",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
