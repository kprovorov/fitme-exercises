{
  "extends": ["ultracite/biome/core", "ultracite/biome/jest"],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    // Generated by `pnpm openapi`; CI checks it's exactly what that writes.
    "includes": ["!openapi.json"]
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "off"
      }
    }
  }
}
